# Copy to .env (gitignored). Keys are read only from the environment and never stored or returned.

# demo | live (default for new workspaces is demo)
MODE=demo
PORT=8000
# 0.0.0.0 lets a phone on the same Wi-Fi reach the API
HOST=0.0.0.0

# ---- Supabase (leave empty to run locally: embedded Postgres in api/data/pglite, sign-in off) ----
# Project URL. When set, every API request needs a signed-in Supabase user.
SUPABASE_URL=
# Postgres connection for the API. Use the Session pooler string from Supabase → Connect (IPv4);
# the direct db.<ref>.supabase.co host is IPv6-only. URL-encode special characters in the password.
DATABASE_URL=
# Only for projects still signing tokens with the legacy shared secret (HS256). New projects use ES256 keys.
# SUPABASE_JWT_SECRET=
# Emails allowed to switch their workspace to live mode (spends the API keys below). Comma-separated.
LIVE_MODE_EMAILS=

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# npm run share / share:public with sign-in OFF: team password for the shared dashboard (8+ characters).
# Ignored when SUPABASE_URL is set (sign-in protects everything).
# SHARE_PASSWORD=

# Web dashboard (web/.env.local) and phone app (app/.env.local) need the public Supabase settings:
#   web/.env.local:  VITE_SUPABASE_URL=...           VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#   app/.env.local:  EXPO_PUBLIC_SUPABASE_URL=...    EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# App: point the phone app at a deployed API instead of your computer.
# EXPO_PUBLIC_API_URL=https://api.example.com
