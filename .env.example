# Copy to .env. Keys are read only from the environment and never stored or returned.

# demo | live
MODE=demo
PORT=8000
# 0.0.0.0 lets a phone on the same Wi-Fi reach the API
HOST=0.0.0.0

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# App: point the phone/web app at a deployed API instead of your computer.
# EXPO_PUBLIC_API_URL=https://api.example.com
